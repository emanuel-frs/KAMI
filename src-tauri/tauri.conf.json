{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kami",
  "version": "1.7.2",
  "identifier": "com.kami.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kami",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob: https://www.google.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "Kami",
    "shortDescription": "Sistema pessoal de organização gamificada, 100% local.",
    "longDescription": "Organize carreira, finanças, aprendizado e metas em um sistema gamificado. Todo o app roda localmente; nenhum dado sai da sua máquina e nenhum serviço pago é necessário.",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Kami",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kami-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
