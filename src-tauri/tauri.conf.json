{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kami",
  "version": "1.14.0",
  "identifier": "com.kami.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kami",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "emanuel-frs",
    "shortDescription": "Sistema pessoal de organização gamificada, local-first.",
    "longDescription": "Organize carreira, finanças, aprendizado e metas em um sistema gamificado. Seus dados ficam num banco SQLite na sua máquina; o app só acessa a internet quando você ativa GitHub, e-mail ou busca. Nenhum serviço pago é necessário.",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 emanuel-frs. Todos os direitos reservados.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kami-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQ0IwNjM0OUQwRUY3MTIKUldRUzl3NmROQWJMM3VxajAzR25Gb0U5azQ3c3RJNlBJM0lNdlkrRFVIams2SDNSOWFBcWRyQXkK",
      "endpoints": [
        "https://github.com/emanuel-frs/KAMI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
